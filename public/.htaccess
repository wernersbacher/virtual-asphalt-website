<IfModule mod_rewrite.c>
  RewriteEngine On
  
  RewriteBase /
  
  # Nicht umschreiben für vorhandene Dateien
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Nicht umschreiben für assets, public oder andere spezifische Verzeichnisse
  RewriteCond %{REQUEST_URI} ^/(assets|public|static|img|data)/ 
  RewriteRule ^ - [L]
  
  # Nicht umschreiben für Dateien mit Dateiendung (außer HTML)
  RewriteCond %{REQUEST_FILENAME} !\.(js|css|json|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot)$
  
  # Alle anderen Anfragen zu index.html umleiten (für React Router)
  RewriteRule ^ index.html [QSA,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # JSON data and the HTML shell: always revalidate (cheap 304 via ETag), so updates show up immediately
  <FilesMatch "\.(json|html|htm)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Images in /img, /data etc. keep their file name when replaced, so they must not be "immutable"
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Vite build output has content hashes in the file names -> cache forever
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
